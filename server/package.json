{
  "name": "@blouck/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/placement.test.ts src/dungeons.test.ts src/db.test.ts src/db/canonical-migrate.test.ts src/directions.test.ts src/integration.test.ts",
    "migrate:canonical": "tsx scripts/migrate-canonical.ts",
    "eval": "tsx eval/run.ts",
    "eval:api": "tsx eval/run.ts --api",
    "eval:dungeons": "tsx eval/dungeons.ts"
  },
  "dependencies": {
    "@blouck/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "elkjs": "^0.12.1",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
