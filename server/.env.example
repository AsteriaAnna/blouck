# 服务端端口
PORT=8787

# SQLite 数据文件（相对 server/ 目录）
DB_PATH=data/mvp.db

# ---- DeepSeek（语言能力：抽取 / 出题 / 判题）----
# 未配置时自动使用 mock，不影响本地跑通
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 豆包 / 火山引擎（流式语音识别）----
# 未配置时自动使用 mock 流式文本
DOUBAO_ASR_APP_ID=
DOUBAO_ASR_TOKEN=
DOUBAO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v2/asr
DOUBAO_ASR_CLUSTER=volcengine_input_common
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_ASR_MODEL=bigmodel
